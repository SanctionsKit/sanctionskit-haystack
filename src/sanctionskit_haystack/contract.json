{
  "components": {
    "schemas": {
      "AppliedMatchingPolicy": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "profile": {
            "type": "string",
            "enum": [
              "standard",
              "focused"
            ]
          },
          "nameThreshold": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "corroboratedNameThreshold": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "retrievalVersion": {
            "type": "string"
          },
          "partialNames": {
            "type": "string",
            "enum": [
              "review",
              "exclude"
            ]
          }
        },
        "required": [
          "version",
          "profile",
          "nameThreshold",
          "corroboratedNameThreshold",
          "retrievalVersion"
        ],
        "additionalProperties": false,
        "description": "Effective matching profile, partial-name policy and retrieval version retained at screening, including no-match results. Historical results can omit this snapshot. Partial names are excluded unless an approved policy explicitly enables review. Scores are not population-calibrated probabilities."
      },
      "Coverage": {
        "type": "object",
        "required": [
          "sourceId",
          "version",
          "retrievedAt",
          "fresh"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "publishedAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ],
            "description": "Authority-supplied publication date (YYYY-MM-DD) or RFC 3339 timestamp, preserving the precision supplied by the publisher. A date-only value does not imply midnight or a timezone. Omitted when no genuine publication date or timestamp is supplied."
          },
          "fresh": {
            "type": "boolean"
          },
          "sourceNotice": {
            "$ref": "#/components/schemas/SourceNotice",
            "description": "Included in new production screening results, including no-match results. Absent from synthetic sandbox coverage and older retained evidence; historical evidence is not rewritten."
          }
        }
      },
      "MatchAssessment": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "similarity": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "method": {
                    "type": "string"
                  },
                  "aliasKind": {
                    "type": "string",
                    "enum": [
                      "primary",
                      "alias"
                    ]
                  },
                  "aliasQuality": {
                    "type": "string",
                    "enum": [
                      "strong",
                      "weak",
                      "unknown"
                    ]
                  }
                },
                "required": [
                  "similarity",
                  "method",
                  "aliasKind",
                  "aliasQuality"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "identifiers": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "agreement",
                  "conflict",
                  "not_supplied",
                  "unavailable",
                  "not_comparable"
                ]
              },
              "matched": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "issuerAgreements": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "issuerUnknown": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "conflicts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "status",
              "matched",
              "issuerAgreements",
              "issuerUnknown",
              "conflicts"
            ],
            "additionalProperties": false
          },
          "birthDate": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "agreement",
                  "conflict",
                  "not_supplied",
                  "unavailable",
                  "not_comparable"
                ]
              },
              "precision": {
                "type": "string",
                "enum": [
                  "year",
                  "month",
                  "day"
                ]
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          },
          "country": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "agreement",
                  "conflict",
                  "not_supplied",
                  "unavailable",
                  "not_comparable"
                ]
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          },
          "entityType": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "agreement",
                  "conflict",
                  "not_supplied",
                  "unavailable",
                  "not_comparable"
                ]
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          },
          "reviewTier": {
            "type": "string",
            "enum": [
              "identifier",
              "corroborated",
              "conflicting",
              "name_only"
            ]
          },
          "alertBasis": {
            "type": "string",
            "enum": [
              "identifier",
              "name",
              "name_and_birth_date",
              "partial_name"
            ]
          },
          "hasConflicts": {
            "type": "boolean"
          },
          "sameNameCandidates": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "identifiers",
          "birthDate",
          "country",
          "entityType",
          "reviewTier",
          "alertBasis",
          "hasConflicts",
          "sameNameCandidates"
        ],
        "additionalProperties": false,
        "description": "Retained name similarity, identity comparison states and review evidence tier. Contains no copied subject values. Missing information, conflicts and partial dates remain distinct; an evidence tier is not a finding of identity or wrongdoing."
      },
      "RetainedScreeningResult": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ScreeningResult"
          },
          {
            "type": "object",
            "properties": {
              "subject": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/Subject"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reference": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "subject",
              "reference"
            ]
          }
        ],
        "description": "GET /results/{id} adds the retained subject and reference to the original result. Both keys are always present here and are null for minimal retention. POST /screenings and GET /results list items return ScreeningResult without these additions."
      },
      "ScreeningPolicySnapshot": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "purpose": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000
          },
          "jurisdictions": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            }
          },
          "matching": {
            "type": "object",
            "properties": {
              "profile": {
                "type": "string",
                "enum": [
                  "standard",
                  "focused"
                ]
              },
              "partialNames": {
                "type": "string",
                "enum": [
                  "review",
                  "exclude"
                ]
              }
            },
            "required": [
              "profile"
            ],
            "additionalProperties": false
          },
          "requiredSources": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "person",
                "organization",
                "vessel",
                "aircraft",
                "other"
              ]
            },
            "additionalProperties": {
              "maxItems": 512,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          },
          "optionalSources": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "person",
                "organization",
                "vessel",
                "aircraft",
                "other"
              ]
            },
            "additionalProperties": {
              "maxItems": 512,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          },
          "exclusions": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 500
            }
          },
          "externalChecks": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            }
          },
          "externalCheckGuidance": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 200
                },
                "instructions": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 2000
                },
                "evidenceExample": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 1000
                }
              },
              "required": [
                "label",
                "instructions"
              ],
              "additionalProperties": false
            }
          },
          "review": {
            "default": {},
            "type": "object",
            "properties": {
              "requireSecondReview": {
                "default": false,
                "type": "boolean"
              },
              "secondReviewFor": {
                "default": [],
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "same_identity",
                    "allow",
                    "restrict",
                    "escalate"
                  ]
                }
              },
              "approverRoles": {
                "default": [
                  "owner",
                  "admin",
                  "analyst"
                ],
                "minItems": 1,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "owner",
                    "admin",
                    "analyst"
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "monitoringIntervalHours": {
            "default": 24,
            "anyOf": [
              {
                "type": "number",
                "const": 6
              },
              {
                "type": "number",
                "const": 24
              },
              {
                "type": "number",
                "const": 168
              }
            ]
          },
          "retentionTrigger": {
            "default": "review_completed",
            "type": "string",
            "enum": [
              "review_completed",
              "relationship_ended",
              "business_event"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "environment": {
            "type": "string",
            "enum": [
              "sandbox",
              "production"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "name",
          "purpose",
          "jurisdictions",
          "requiredSources",
          "optionalSources",
          "exclusions",
          "externalChecks",
          "review",
          "monitoringIntervalHours",
          "retentionTrigger",
          "id",
          "version",
          "environment",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "ScreeningRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "subject": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2,
                "maxLength": 300,
                "description": "Name to compare with publisher records. Leading and trailing whitespace is removed; provide the fullest reliable name available."
              },
              "entityType": {
                "default": "person",
                "type": "string",
                "enum": [
                  "person",
                  "organization",
                  "vessel",
                  "aircraft",
                  "other"
                ],
                "description": "Type of subject. Defaults to person when omitted. Every selected source must support this type."
              },
              "identifiers": {
                "default": [],
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "description": "Identifier scheme, such as passport, national_id, registration, lei, imo or mmsi. Matching normalizes supported scheme aliases."
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160,
                      "description": "Identifier value. Send the original value; scheme-specific normalization is applied during matching."
                    },
                    "issuer": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "description": "Optional issuing authority or country. Omit when unknown; do not send null."
                    }
                  },
                  "required": [
                    "type",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "description": "Typed identifiers used for exact matching, such as passport, national_id, registration, lei, imo or mmsi. Defaults to an empty array. Use the publisher\u2019s identifier scheme; custom scheme names are accepted."
              },
              "birthDate": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?!0000)\\d{4}$"
                  },
                  {
                    "type": "string",
                    "pattern": "^(?!0000)\\d{4}-(0[1-9]|1[0-2])$"
                  },
                  {
                    "type": "string",
                    "allOf": [
                      {
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                      },
                      {
                        "pattern": "^(?!0000)"
                      }
                    ]
                  }
                ],
                "description": "Known date or partial date: YYYY, YYYY-MM or YYYY-MM-DD. Preserve known precision; do not invent a month or day. Year 0000 and invalid dates are rejected."
              },
              "country": {
                "type": "string",
                "minLength": 2,
                "maxLength": 100,
                "description": "Known country name or code used as supporting identity evidence. It is not a source-selection or geographic coverage filter."
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "description": "Identity to screen. name is required; entityType defaults to person and identifiers defaults to an empty array."
          },
          "counterpartyId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Optional existing active counterparty UUID in the same organization and environment. The submitted subject must match its current identity; this does not create a counterparty."
          },
          "policy": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "Policy UUID from GET /policies."
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "Exact approved policy version from GET /policies. Reload the policy if that version is no longer available."
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false,
            "description": "Approved organization policy reference. Required when GET /policies returns requirePolicy=true. A supplied policy must be current and compatible with the subject and requested coverage.",
            "x-required-when": "GET /policies returns requirePolicy=true for the current API key environment."
          },
          "reference": {
            "type": "string",
            "maxLength": 160,
            "description": "Optional caller reference (up to 160 characters). It is retained with standard evidence and returned by GET /results/{id}; it is null in minimal-retention retrieval."
          },
          "sources": {
            "minItems": 1,
            "maxItems": 512,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "description": "Explicit source IDs from GET /sources. Provide sources or package, exactly one. Every selected source must be available, fresh and support the subject type; unavailable coverage fails closed."
          },
          "package": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "One versioned coverage package, mutually exclusive with sources. Sandbox accepts only sandbox@1. Use only a package available to the selected environment; no implicit global coverage is applied."
          },
          "retention": {
            "default": "standard",
            "type": "string",
            "enum": [
              "standard",
              "minimal"
            ],
            "description": "standard retains inputs and evidence under organization/case policy. minimal is available only for individual API-key screenings, lasts 24 hours, omits submitted inputs, and cannot create a review case. Governance requirements can require standard. Defaults to standard."
          }
        },
        "required": [
          "subject"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "sources"
            ],
            "not": {
              "required": [
                "package"
              ]
            }
          },
          {
            "required": [
              "package"
            ],
            "not": {
              "required": [
                "sources"
              ]
            }
          }
        ],
        "description": "Single subject input. Exactly one of sources or package is required. Only subject is unconditionally required; coverage and approved policy also have conditional requirements described below."
      },
      "ScreeningResult": {
        "type": "object",
        "required": [
          "id",
          "environment",
          "status",
          "createdAt",
          "matches",
          "coverage",
          "versions",
          "disclaimer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Screening UUID; use it to retrieve retained result/evidence and locate linked review cases."
          },
          "environment": {
            "enum": [
              "sandbox",
              "production"
            ],
            "description": "Environment owned by the API key. Sandbox evidence is synthetic."
          },
          "status": {
            "enum": [
              "potential_match",
              "no_match"
            ],
            "description": "potential_match requires review of candidates; no_match means no returned candidates within the selected coverage and matching rules. Neither is a business approval or legal clearance."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Screening creation timestamp in ISO 8601 UTC."
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "record",
                "score",
                "evidence",
                "conflicts"
              ],
              "properties": {
                "record": {
                  "$ref": "#/components/schemas/SourceRecord"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Legacy composite review score retained for compatibility. Use assessment.name.similarity for name similarity and assessment for corroboration and conflicts. Not a probability of identity or wrongdoing."
                },
                "assessment": {
                  "$ref": "#/components/schemas/MatchAssessment"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "field",
                      "queryValue",
                      "sourceValue",
                      "method",
                      "contribution",
                      "explanation"
                    ],
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "queryValue": {
                        "type": "string"
                      },
                      "sourceValue": {
                        "type": "string"
                      },
                      "method": {
                        "type": "string"
                      },
                      "contribution": {
                        "type": "number"
                      },
                      "explanation": {
                        "type": "string"
                      }
                    }
                  }
                },
                "conflicts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "Candidate records with field evidence and conflicts. Always an array; empty for no_match. No silent truncation is performed."
          },
          "coverage": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Coverage"
            },
            "description": "Exact source versions used, including freshness and retained publisher notices. Always present, including no_match."
          },
          "versions": {
            "type": "object",
            "required": [
              "dataset",
              "matchingEngine",
              "policy"
            ],
            "properties": {
              "dataset": {
                "type": "string"
              },
              "matchingEngine": {
                "type": "string"
              },
              "policy": {
                "type": "string"
              },
              "package": {
                "type": "string"
              }
            },
            "description": "Dataset, matching engine and policy versions used for this result. package is included only for package-based coverage."
          },
          "disclaimer": {
            "type": "string",
            "description": "Interpretation limits supplied with this result; preserve them when presenting or exporting evidence."
          },
          "policySnapshot": {
            "$ref": "#/components/schemas/ScreeningPolicySnapshot",
            "description": "Immutable organization policy applied at screening time, when one was selected. Omitted when no organization policy applied."
          },
          "matching": {
            "$ref": "#/components/schemas/AppliedMatchingPolicy",
            "description": "Applied Standard or Focused alert profile, comparison thresholds, partial-name policy and retrieval version. Saved with new results, including no-match results; omitted on historical results without this evidence. Set matching.partialNames to review on an approved screening policy to include weaker token-prefix and missing-name-part evidence. Omission or exclude preserves complete-name matching. Select sensitivity through a versioned policy, not an arbitrary request-level cutoff."
          },
          "warnings": {
            "type": "array",
            "description": "Input limitations without copied subject values. A one-word person name produces limited_name_information; legitimate single-word names are accepted. Preserve this warning with no-match outcomes and retained evidence. Historical results may omit it.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "limited_name_information"
                  ]
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "Result returned by POST /screenings and plain GET /results items. Its required fields are always present. A successful result is either potential_match or no_match; failures use the Error envelope instead."
      },
      "SourceNotice": {
        "type": "object",
        "required": [
          "text",
          "sourceUrl",
          "termsUrl"
        ],
        "properties": {
          "text": {
            "type": "string",
            "description": "Required publisher attribution and reuse notices captured when screening runs."
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "termsUrl": {
            "type": "string",
            "format": "uri"
          },
          "licenseUrl": {
            "type": "string",
            "format": "uri",
            "description": "Only included for a reviewed explicit license instrument."
          },
          "databaseDownloadUrl": {
            "type": "string",
            "format": "uri-reference",
            "description": "Free complete derivative database for the exact immutable source version, where required. A relative path resolves against this API origin."
          }
        }
      },
      "SourceProvenance": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "recordId": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "rawValue": {
            "type": "string"
          }
        },
        "required": [
          "sourceId",
          "recordId",
          "field"
        ],
        "description": "Publisher field attribution. rawValue is optional; when present it preserves the original published value."
      },
      "SourceRecord": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "authority",
          "list",
          "sourceUrl",
          "entityType",
          "names",
          "identifiers",
          "birthDates",
          "addresses",
          "nationalities",
          "designations",
          "extensions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          },
          "list": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string"
          },
          "entityType": {
            "type": "string",
            "enum": [
              "person",
              "organization",
              "vessel",
              "aircraft",
              "other"
            ]
          },
          "names": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "kind"
              ],
              "properties": {
                "value": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "primary",
                    "alias"
                  ]
                },
                "quality": {
                  "enum": [
                    "strong",
                    "weak",
                    "unknown"
                  ]
                },
                "script": {
                  "type": "string"
                },
                "provenance": {
                  "$ref": "#/components/schemas/SourceProvenance"
                }
              }
            }
          },
          "identifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "issuer": {
                  "type": "string"
                },
                "provenance": {
                  "$ref": "#/components/schemas/SourceProvenance"
                }
              }
            }
          },
          "birthDates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "precision",
                "original"
              ],
              "properties": {
                "value": {
                  "type": "string"
                },
                "precision": {
                  "enum": [
                    "day",
                    "month",
                    "year",
                    "range",
                    "unknown"
                  ]
                },
                "original": {
                  "type": "string"
                }
              }
            }
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                },
                "provenance": {
                  "$ref": "#/components/schemas/SourceProvenance"
                }
              }
            }
          },
          "nationalities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "designations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "category",
                "programs",
                "legalReferences"
              ],
              "properties": {
                "category": {
                  "enum": [
                    "financial_sanctions",
                    "export_control",
                    "debarment",
                    "other"
                  ]
                },
                "programs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "legalReferences": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "wording": {
                  "type": "string"
                },
                "effectiveDate": {
                  "type": "string"
                }
              }
            }
          },
          "dataThrough": {
            "type": "string",
            "format": "date",
            "description": "Inclusive publisher data-availability deadline; not a legal end date."
          },
          "screeningPeriods": {
            "type": "array",
            "maxItems": 1000,
            "description": "Inclusive UTC date intervals for current screening. Omitted means no date filter; an empty array excludes the record from current screening.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string",
                  "format": "date"
                },
                "through": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          },
          "publicContext": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "label",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 100
                },
                "value": {
                  "type": "string",
                  "maxLength": 2000
                }
              }
            }
          },
          "extensions": {
            "type": "object",
            "additionalProperties": true,
            "description": "Source-specific published extensions. Keys and value shapes vary by source; preserve unknown values without assuming a fixed schema."
          }
        }
      },
      "Subject": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 300,
            "description": "Name to compare with publisher records. Leading and trailing whitespace is removed; provide the fullest reliable name available."
          },
          "entityType": {
            "default": "person",
            "type": "string",
            "enum": [
              "person",
              "organization",
              "vessel",
              "aircraft",
              "other"
            ],
            "description": "Type of subject. Defaults to person when omitted. Every selected source must support this type."
          },
          "identifiers": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "Identifier scheme, such as passport, national_id, registration, lei, imo or mmsi. Matching normalizes supported scheme aliases."
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "description": "Identifier value. Send the original value; scheme-specific normalization is applied during matching."
                },
                "issuer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "description": "Optional issuing authority or country. Omit when unknown; do not send null."
                }
              },
              "required": [
                "type",
                "value"
              ],
              "additionalProperties": false
            },
            "description": "Typed identifiers used for exact matching, such as passport, national_id, registration, lei, imo or mmsi. Defaults to an empty array. Use the publisher\u2019s identifier scheme; custom scheme names are accepted."
          },
          "birthDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!0000)\\d{4}$"
              },
              {
                "type": "string",
                "pattern": "^(?!0000)\\d{4}-(0[1-9]|1[0-2])$"
              },
              {
                "type": "string",
                "allOf": [
                  {
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  {
                    "pattern": "^(?!0000)"
                  }
                ]
              }
            ],
            "description": "Known date or partial date: YYYY, YYYY-MM or YYYY-MM-DD. Preserve known precision; do not invent a month or day. Year 0000 and invalid dates are rejected."
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "description": "Known country name or code used as supporting identity evidence. It is not a source-selection or geographic coverage filter."
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    }
  }
}
